# ═══════════════════════════════════════════════════════════════════════════════
# MediSphere AI — Enterprise Environment Configuration Template
# Copy this file to .env and populate with your production or local secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment & Runtime ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MediSphere AI"
API_VERSION=v1

# ─── Security & Cryptography ──────────────────────────────────────────────────
# Generate a cryptographically secure 256-bit key: openssl rand -hex 32
SECRET_KEY=GENERATE_WITH__python_-c_"import_secrets;_print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MongoDB Atlas Cluster Connection ─────────────────────────────────────────
# URI must include credentials and target database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=medisphere_db

# ─── Redis Caching & Event Pub/Sub ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Must match config.py field name: REDIS_TTL (not REDIS_CACHE_TTL_SECONDS)
REDIS_TTL=3600

# ─── Vector Database (Qdrant) for RAG Clinical Knowledge ─────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_guidelines

# ─── Ollama / Local LLM Multi-Agent Orchestrator ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Must match config.py field names: OLLAMA_MODEL and EMBEDDING_MODEL
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── OpenRouter Cloud LLM AI Assistant (DeepSeek / Claude / GPT / Qwen) ──────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# ─── CORS Policy ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://medisphere-ai.example.com"]

# ─── Frontend Next.js Public Environment Variables ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/dashboard
NEXT_PUBLIC_HOSPITAL_NAME="MediSphere Central Hospital"
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
