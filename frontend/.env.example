# ─── MediSphere AI — Frontend Environment Configuration ──────────────────────
# Copy to .env.local for local development

# Base REST API Gateway
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Real-Time WebSocket Feeds (Emergency, Department Alerts, Vitals)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Hospital Brand & NABH Header Info
NEXT_PUBLIC_HOSPITAL_NAME="MediSphere AI Super Speciality Hospital"
NEXT_PUBLIC_HOSPITAL_UHID_PREFIX="MS-2026"
NEXT_PUBLIC_EMERGENCY_HELPLINE="108"

# Development & Resilience Flags
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
